# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
template1 = GetTemplate(TemplateName="Fluid Flow")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit()
geometry1.Exit()
template2 = GetTemplate(
    TemplateName="Steady-State Thermal",
    Solver="ANSYS")
system2 = template2.CreateSystem()
system1.Delete()
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit()
geometry2.Exit()
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Update(AllDependencies=True)
model1 = system2.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
model1.Exit()
template3 = GetTemplate(TemplateName="Mechanical APDL")
geometryComponent1 = system2.GetComponent(Name="Geometry")
componentTemplate1 = GetComponentTemplate(Name="ANSYSSetupCellTemplate")
system3 = template3.CreateSystem(
    DataTransferFrom=[Set(FromComponent=geometryComponent1, TransferName=None, ToComponentTemplate=componentTemplate1)],
    RelativeTo=system2)
system3.Delete()
system4 = template2.CreateSystem()
geometry3 = system4.GetContainer(ComponentName="Geometry")
geometry3.Edit()
geometry3.Exit()
modelComponent2 = system4.GetComponent(Name="Model")
modelComponent2.Update(AllDependencies=True)
model2 = system4.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
geometryComponent2 = system4.GetComponent(Name="Geometry")
geometryComponent2.Update(AllDependencies=True)
modelComponent2.Update(AllDependencies=True)
geometry3.Edit()
geometry3.Exit()
engineeringDataComponent1 = system4.GetComponent(Name="Engineering Data")
system5 = system4.Duplicate(
    ComponentsToShare=[engineeringDataComponent1],
    RelativeTo=system4)
system5.Delete()
modelComponent2.Clean()
modelComponent2.Clean()
modelComponent2.Update(AllDependencies=True)
geometry3.Edit()
geometry3.Exit()
model2.Edit()
geometry3.Edit()
model2.Exit()
geometry3.Exit()
modelComponent2.Refresh()
model2.Edit()
Save(Overwrite=True)
